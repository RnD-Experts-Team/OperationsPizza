APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=operationspizza
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================================================
# Operations service — everything below is the COMPLETE custom configuration.
# Vendor URLs, timeouts, rate limits etc. are hardcoded in config/{tcp,humanity}.php.
# ===========================================================================

OPERATIONS_DEFAULT_TIMEZONE=America/Chicago

# pizzasys auth server (AuthTokenStoreScopeMiddleware).
# call_token = the raw token printed ONCE by pizzasys' OperationsServiceSeeder.
AUTH_SERVER_BASE_URL=
AUTH_SERVER_CALL_TOKEN=

# NATS / JetStream. DEV_MODE=1 swaps every subject+stream to its *.testing.*
# twin — it must MATCH HiringPizza's DEV_MODE or the services silently stop
# talking to each other. Streams and durable consumers are created by hand
# with the NATS CLI (use --deliver=all); the app never calls create().
DEV_MODE=1
NATS_HOST=127.0.0.1
NATS_PORT=4222
NATS_TOKEN=
# ...or NATS_USER= / NATS_PASS= instead of a token.

# ---------------------------------------------------------------------------
# Humanity — schedule source of truth. NO SANDBOX EXISTS; these credentials
# are the live account. driver=fake (in-memory double) until go-live.
# Register the app at Humanity -> Settings -> API v2; auth is the `password`
# grant, and the user's ROLE is the permission model (needs Manager/Supervisor).
# ---------------------------------------------------------------------------
HUMANITY_DRIVER=fake
HUMANITY_WRITES_ENABLED=false
HUMANITY_CLIENT_ID=
HUMANITY_CLIENT_SECRET=
HUMANITY_USERNAME=
HUMANITY_PASSWORD=
# Hourly reconcile cron — opt in ONLY after manual `humanity:reconcile
# --dry-run` diffs have been read clean (first pass imports the live schedule).
HUMANITY_RECONCILE_CRON=false

# ---------------------------------------------------------------------------
# TCP Manager+ / TimeClock Plus — clocking and worked hours. NO SANDBOX
# EXISTS. Auth is client_credentials. Quota: 2500 requests/day for the whole
# service — run `php artisan tcp:quota` before enabling anything.
# ---------------------------------------------------------------------------
TCP_DRIVER=fake
TCP_WRITES_ENABLED=false
TCP_CLIENT_ID=
TCP_CLIENT_SECRET=
TCP_API_KEY=
TCP_COMPANY_ID=1
# Optional account-wide fallback job code (e.g. 1000 = Regular) for employees
# whose position matches none of their store's per-store codes.
TCP_DEFAULT_JOB_CODE=

# ---------------------------------------------------------------------------
# Rollout guard: comma-separated store_numbers allowed to receive external
# writes (shifts, punches, reconciler imports). Unset = unrestricted.
# Start with just the test store, widen store by store, unset at full rollout.
# ---------------------------------------------------------------------------
EXTERNAL_WRITE_ALLOWED_STORES=
