APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=operationspizza
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Operations service ---------------------------------------------------
OPERATIONS_DEFAULT_TIMEZONE=America/Chicago

# pizzasys auth server (AuthTokenStoreScopeMiddleware)
# call_token = the raw token of this service's `service_clients` row in pizzasys
AUTH_SERVER_BASE_URL=
AUTH_SERVER_VERIFY_PATH=/api/v1/auth/token/verify
# Must equal service_clients.name AND auth_rules.service in pizzasys.
AUTH_SERVER_SERVICE_NAME=Operations
AUTH_SERVER_CALL_TOKEN=
AUTH_SERVER_TIMEOUT=3
AUTH_SERVER_RETRIES=1
AUTH_SERVER_RETRY_MS=100
AUTH_SERVER_CACHE_TTL=30

# NATS / JetStream
# DEV_MODE=1 swaps every subject+stream to its *.testing.* twin.
DEV_MODE=1
NATS_HOST=127.0.0.1
NATS_PORT=4222
NATS_TOKEN=
NATS_USER=
NATS_PASS=
NATS_PULL_BATCH=25
NATS_PULL_TIMEOUT_MS=2000
NATS_PULL_SLEEP_MS=250
# Stream/consumer names. The defaults shown are what config/nats.php uses, and
# they already flip to *_TESTING_* when DEV_MODE=1 — only set these if your
# broker uses different names. The streams and durable consumers must be
# created by hand with the NATS CLI; the app never calls create().
# NATS_OPERATIONS_STREAM=OPERATIONS_EVENTS      # we publish here
# NATS_NOTIFICATIONS_STREAM=NOTIFICATIONS_EVENTS
# NATS_AUTH_STREAM=AUTH_EVENTS                  # we consume these
# NATS_AUTH_DURABLE=OPERATIONS_AUTH_CONSUMER
# NATS_HIRING_STREAM=HIRING_EVENTS
# NATS_HIRING_DURABLE=OPERATIONS_HIRING_CONSUMER

# TCP Humanity (scheduling source of truth)
# Register the app at Humanity -> Settings -> API v2.
# v2 has no client_credentials grant: it authenticates AS a real user, whose
# role IS the permission model. POST/DELETE /shifts need Manager(2) or
# Supervisor(3), so the service account must be one of those.
HUMANITY_DRIVER=fake
# No default on purpose. Production is live with real users.
HUMANITY_ENV=sandbox
# Keep false until humanity:backfill-employee-ids has matched the live roster,
# or upsertStaff duplicates every employee that was created by hand.
HUMANITY_WRITES_ENABLED=false
HUMANITY_BASE_URL=https://www.humanity.com/api/v2
HUMANITY_TOKEN_URL=https://www.humanity.com/oauth2/token.php
HUMANITY_CLIENT_ID=
HUMANITY_CLIENT_SECRET=
HUMANITY_USERNAME=
HUMANITY_PASSWORD=
HUMANITY_REDIRECT_URI=
HUMANITY_TIMEOUT=10
HUMANITY_RETRIES=2
HUMANITY_RPS=3
HUMANITY_RECONCILE_DAYS_BACK=7
HUMANITY_RECONCILE_DAYS_FORWARD=21

# ---------------------------------------------------------------------------
# TCP Manager+ / TimeClock Plus — clocking and worked hours
# ---------------------------------------------------------------------------
# A SEPARATE system from Humanity, with its own credentials. TCP is the system
# of record for employees, leave and job codes; Humanity owns only the schedule.
# TCP's own connector syncs the two every 5 minutes.
# Docs: https://timeclock-plus.readme.io
#
# Auth is client_credentials — a real machine-to-machine grant, so unlike
# Humanity there is no user password to expire or 2FA to trip over.
TCP_DRIVER=fake
# No default on purpose. Production holds live clocking data.
TCP_ENV=sandbox
TCP_WRITES_ENABLED=false
TCP_BASE_URL=https://api.tcplusondemand.com/v1
TCP_TOKEN_URL=https://auth.api.tcplusondemand.com/oauth2/token
TCP_CLIENT_ID=
TCP_CLIENT_SECRET=
TCP_API_KEY=
TCP_COMPANY_ID=1
TCP_SCOPE="tcp-openapi/tcpopenapi.write tcp-openapi/tcpopenapi.read"
TCP_TIMEOUT=10
TCP_RETRIES=2
# RATE LIMITS ARE THE BINDING CONSTRAINT: 60/minute AND 2500 per 24 hours —
# about 104/hour for the entire service. The reserve is held back so an
# interactive clock-in is never starved by a background sync.
TCP_RATE_PER_MINUTE=60
TCP_RATE_PER_DAY=2500
TCP_RATE_RESERVE_PER_DAY=250
TCP_TIMECLOCK_LOOKBACK_DAYS=14
TCP_TIMECLOCK_OVERLAP_MINUTES=30
